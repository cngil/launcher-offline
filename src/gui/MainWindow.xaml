<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher Offline" Width="640" SizeToContent="Height" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltips: small dark rounded label instead of the classic yellow-ish box. -->
        <Style TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1F2937" CornerRadius="6" Padding="10,6" Margin="0,4,0,0" MaxWidth="420">
                            <ContentPresenter TextElement.Foreground="White" TextElement.FontSize="12"
                                              TextElement.FontFamily="Segoe UI">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scroll bar with a rounded thumb. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="4,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bd" Background="#CBD5E1" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#94A3B8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#64748B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language picker: rounded pill with a globe, opens a soft drop-down list. -->
        <Style x:Key="LanguagePicker" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                                CornerRadius="17" Padding="12,6,12,6">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse Width="14" Height="14" Stroke="#6B7280" StrokeThickness="1.3"/>
                                        <Ellipse Canvas.Left="3.5" Width="7" Height="14" Stroke="#6B7280" StrokeThickness="1.3"/>
                                        <Line X1="0.7" Y1="7" X2="13.3" Y2="7" Stroke="#6B7280" StrokeThickness="1.3"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{TemplateBinding Foreground}" Margin="8,0,10,0" VerticalAlignment="Center"/>
                                    <Path Data="M0,0 L4,4 L8,0" Stroke="#6B7280" StrokeThickness="1.5" VerticalAlignment="Center"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Toggle}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10"
                                        Padding="4" Margin="0,0,10,10" MinWidth="{Binding ActualWidth, ElementName=Toggle}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.15"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" CornerRadius="6" Padding="10,7" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <DockPanel Margin="28,24,28,20">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="AppIcon" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                </StackPanel>
                <ComboBox x:Name="LanguageBox" Style="{StaticResource LanguagePicker}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" DisplayMemberPath="Name"/>
            </Grid>
            <TextBlock x:Name="SubtitleText" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,6,0,18" LineHeight="20"/>
            <Border x:Name="Banner" Visibility="Collapsed" CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" LineHeight="20"/>
            </Border>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MissingText" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock x:Name="FooterText" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>
                <TextBlock FontSize="12" Margin="0,4,0,0">
                    <Hyperlink x:Name="RepoLink" Foreground="#2563EB" TextDecorations="{x:Null}" Cursor="Hand">
                        <Run x:Name="RepoLinkText"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="ResetButton" HorizontalAlignment="Left" Background="Transparent" Foreground="#B91C1C" Padding="4,6" FontWeight="Normal"/>
            <Button x:Name="RefreshButton" HorizontalAlignment="Right" Background="White" Foreground="#111827" BorderBrush="#D1D5DB"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Cards"/>
        </ScrollViewer>
    </DockPanel>

    <!-- In-window dialog, styled like the rest of the app (replaces native message boxes). -->
    <Grid x:Name="DialogLayer" Visibility="Collapsed" Background="#73111827">
        <Border Background="White" CornerRadius="14" Padding="24,22,24,20" Margin="32" MaxWidth="460"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap"/>
                <TextBlock x:Name="DialogText" FontSize="14" Foreground="#4B5563" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,22"/>
                <WrapPanel x:Name="DialogButtons" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
